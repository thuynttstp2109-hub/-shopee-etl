# Sao chép file này thành .env rồi điền thông tin

# --- Shopee Affiliate Open API ---
# Lấy trong trang affiliate.shopee.vn > Open API sau khi được duyệt
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
# Kiểm tra lại endpoint trong tài liệu Open API trên dashboard affiliate của bạn
SHOPEE_API_URL=https://open-api.affiliate.shopee.vn/graphql
# true = dùng dữ liệu giả lập. Đổi thành false khi đã có App ID / Secret
SHOPEE_MOCK=true

# Từ khóa cần theo dõi, cách nhau bởi dấu phẩy
SHOPEE_KEYWORDS=tai nghe bluetooth,ban phim co,chuot gaming
SHOPEE_PAGE_LIMIT=50
SHOPEE_MAX_PAGES=5
# 1=liên quan, 2=bán chạy, 3=giá cao->thấp, 4=giá thấp->cao, 5=hoa hồng cao
SHOPEE_SORT_TYPE=2
# Số giây nghỉ giữa các request
SHOPEE_REQUEST_DELAY=1.5

# --- Data lake ---
# s3 = MinIO trong docker-compose, local = thư mục ./data_lake
STORAGE_BACKEND=s3
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=shopee-lake
LOCAL_LAKE_DIR=./data_lake

# --- Kho dữ liệu ---
DW_DSN=postgresql://dw:dw@postgres-dw:5432/shopee_dw
